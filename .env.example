# Copy to .env (or export as real env vars) before running the backend.
# NEVER commit a real .env file.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/velora
DB_USERNAME=velora
DB_PASSWORD=velora
DB_POOL_SIZE=10

# --- JWT (access token) ---
# Required. Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime in milliseconds (default 15m). Keep it short - an access token
# cannot be revoked, so this is how long a stolen one keeps working. Clients call
# POST /api/auth/refresh to get a new one.
JWT_EXPIRATION_MS=900000

# --- Sessions & password recovery ---
# How long a refresh token stays valid (ISO-8601 duration or Spring style: 30d, 12h, 45m)
REFRESH_TOKEN_TTL=30d
# How long a password reset token stays valid
PASSWORD_RESET_TTL=30m

# --- CORS ---
# Comma-separated list of allowed origins for the mobile app / dev tools
CORS_ALLOWED_ORIGINS=http://localhost:19000,http://localhost:8081

# --- Server ---
PORT=8080
